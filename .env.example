
# ── TestRail Integration ─────────────────────────────────────────────────────
# Required — set TESTRAIL_ENABLED=true only for testrail:* scripts
TESTRAIL_ENABLED=false
TESTRAIL_HOST=https://yourorg.testrail.io
TESTRAIL_USERNAME=your_testrail_email@example.com
TESTRAIL_API_KEY=your_testrail_api_key
TESTRAIL_PROJECT_ID=                    # Numeric TestRail project ID

# Optional
TESTRAIL_SUITE_ID=                      # Required for multi-suite projects
TESTRAIL_RUN_NAME=                      # Defaults to "Cypress Run – <timestamp> UTC"
TESTRAIL_CLOSE_RUN=false                # Set to "true" to close the run after posting
TESTRAIL_RUN_ID=                        # Existing run ID — skips run creation, posts into this run instead


#Environment variables for Cypress tests
CYPRESS_BASE_URL=https://devstudio.fuse.ai
CYPRESS_APP_URL=https://devstudio.fuse.ai
CYPRESS_API_URL=https://devstudio.fuse.ai/api
CYPRESS_PROJECT_ID=11
CYPRESS_CHAT_PATH=/dbagent/11/chat
CYPRESS_USER_EMAIL=your_email@example.com
CYPRESS_USER_PASSWORD=your_password
